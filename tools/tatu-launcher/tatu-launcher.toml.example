# ~/.config/tatu/launcher.toml
#
# Tatu Launcher reads this on every Steam invocation. Pick which real
# Proton runs underneath, and which games actually go through the
# Win32 bridge. Games not listed (or with tatu_enabled = false) just
# passthrough to default_proton transparently — the per-game Proton
# picker in Steam stays meaningful because Tatu Launcher defers to it
# via this file.

# Default Proton if a game isn't listed below. Either:
#   - A directory name under ~/.steam/root/compatibilitytools.d/ (custom builds, e.g. "GE-Proton9-25")
#   - A directory name under ~/.steam/root/steamapps/common/      (official, e.g. "Proton - Experimental")
#   - An absolute path to a `proton` binary
default_proton = "Proton - Experimental"

# Per-game override. The table key is the Steam appid.
# Example: Ender Magnolia (1731120 — adjust to your library).
[games.1731120]
# Optional. Falls back to default_proton when absent.
proton = "Proton - Experimental"
# Optional. The exe basename the bridge should OpenProcess against
# AFTER it is the inner CreateProcess child. When absent, the
# launcher uses basename(argv[2]) — works for any game where Steam
# launches the real game.exe directly (no intermediate launcher.exe).
target_exe = "EnderMagnoliaSteam-Win64-Shipping.exe"
# If false (or absent for unlisted games), the launcher just runs the
# game under `proton` without the bridge. Set true to enable Tatu.
tatu_enabled = true
